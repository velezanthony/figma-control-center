# =====================================================================
# figma-control-center — variables de entorno
# Ninguna es obligatoria: descomenta solo las que quieras cambiar.
# =====================================================================

# =====================================================================
# PRODUCCIÓN (uso normal)
# =====================================================================

# --- Chrome con la sesión de Figma ---
# FIGMA_CHROME_PROFILE=~/.cache/figma-control-center-chrome
# FIGMA_CHROME_SEED_PROFILE=
# FIGMA_CDP_HOST=127.0.0.1
# FIGMA_CDP_PORT=9222
# FIGMA_CDP_CALL_TIMEOUT_MS=300000
# FIGMA_READY_TIMEOUT_MS=60000

# --- Panel ---
# FCC_DASHBOARD_HOST=127.0.0.1
# FCC_DASHBOARD_PORT=4173
# FCC_DASHBOARD_HISTORY=500
# production o development (development añade «Componentes», la galería del propio panel)
# FCC_DASHBOARD_MODE=production
# FCC_LIVE_POLL_MS=500
# FCC_CHAT_POLL_MS=700

# --- Agente lanzado desde el panel ---
# FCC_AGENT_TERMINAL=gnome-terminal --
# FCC_AGENT_LAUNCH_TIMEOUT_MS=120000

# --- Base de datos e histórico ---
# FCC_DB=output/figma.db
# FCC_HISTORY_RETENTION_DAYS=90
# FCC_HISTORY_MAX_ROWS=200
# FCC_HISTORY_STEP_EXCERPT_BYTES=300

# --- Carpetas ---
# FCC_SCRIPTS_ROOT=scripts
# FCC_OUTPUT_DIR=output
# FCC_ACTIVITY_FILE=
# FCC_LOCK_DIR=~/.cache/figma-control-center-locks

# --- Scripts y lotes ---
# FCC_SOFT_DEADLINE_MS=20000
# FCC_MAX_INLINE_RESULT_BYTES=20000
# FCC_ACTIVITY_CODE_PREVIEW_CHARS=200
# FCC_BUILD_MAX_STEPS=50
# FCC_BUILD_STEP_TIMEOUT_MS=120000
# FCC_PROGRESS_MIN_INTERVAL_MS=500
# FCC_MAX_PARAMS_BYTES=20000
# FCC_MAX_ASSET_BYTES=5000000

# =====================================================================
# DESARROLLO (pruebas de contrato: make e2e-record / make e2e-contract)
# =====================================================================

# FIGMA_TEST_FILE_URL=
